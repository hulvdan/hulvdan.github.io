{
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "docs": true
  },
  "runOnSave.commands": [
    {
      "match": ".(json|css)$",
      "command": "prettier -w ${file}",
      "clearOutput": true
    },
    {
      "match": "^(?!.*settings\\.json$).*",
      "command": "uv run cog -n utf-8 -U -r -P --markers=\"[[[cog cog]]] [[[end]]]\" ${file} && uv run python main.py build",
      "clearOutput": true
    },
    {
      "match": ".pyi?$",
      "command": "uv run ruff format ${file} && uv run ruff check --select I ${file} --fix",
      "clearOutput": true
    }
  ],
  "launches": {
    "run_f5": "build"
  },
  "cSpell.words": [
    "foldfix",
    "gaems",
    "gdir",
    "gdisable",
    "gexit",
    "gprefix",
    "maek"
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#c4b478",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#c4b478",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#3a8575",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#c4b478",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#c4b478",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "editorGroup.border": "#c4b478",
    "panel.border": "#c4b478",
    "sash.hoverBorder": "#c4b478",
    "sideBar.border": "#c4b478",
    "statusBar.background": "#b4a055",
    "statusBar.border": "#b4a055",
    "statusBar.debuggingBackground": "#b4a055",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.foreground": "#15202b",
    "statusBar.inactiveBackground": "#b4a055",
    "statusBarItem.hoverBackground": "#948342",
    "statusBarItem.remoteBackground": "#d3ebe6",
    "statusBarItem.remoteForeground": "#15202b",
    "tab.activeBackground": "#c4b478",
    "tab.activeBorder": "#c4b478",
    "titleBar.activeBackground": "#b4a055",
    "titleBar.activeForeground": "#15202b",
    "titleBar.border": "#b4a055",
    "titleBar.inactiveBackground": "#b4a05599",
    "titleBar.inactiveForeground": "#15202b99",
    "window.activeBorder": "#c4b478",
    "window.inactiveBorder": "#c4b478"
  },
  "peacock.color": "#b4a055"
}
